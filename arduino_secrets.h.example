#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

/*
 * Copy this file to arduino_secrets.h (which is gitignored) and fill in your
 * real Wi-Fi and MQTT credentials. Never commit arduino_secrets.h.
 */

#define SECRET_SSID      "your-wifi-ssid"
#define SECRET_PASS      "your-wifi-password"
#define SECRET_MQTT_ID   "your-mqtt-client-id"
#define SECRET_MQTT_USER "your-mqtt-username"
#define SECRET_MQTT_PASS "your-mqtt-password"
#define SECRET_BROKER    "192.168.1.100"

#endif /* ARDUINO_SECRETS_H */
